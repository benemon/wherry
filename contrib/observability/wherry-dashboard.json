    {
      "id": 20,
      "type": "timeseries",
      "title": "Adoptions and redeliveries",
      "description": "Runs that adopted an earlier attempt's job, and runs executed on a redelivery, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
