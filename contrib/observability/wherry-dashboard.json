{
  "title": "wherry receivers",
  "uid": "wherry-receivers",
  "description": "Receivers, admission, run durations, plugins and Kafka for wherry pools, from the receiver's /metrics.",
  "tags": [
    "wherry"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://benemon.github.io/wherry/runbooks",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "pool",
        "label": "Pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(wherry_capacity, pool)",
          "refId": "pool"
        },
        "definition": "label_values(wherry_capacity, pool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Receiver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(wherry_capacity{pool=~\"$pool\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(wherry_capacity{pool=~\"$pool\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Receivers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Receivers reporting",
      "description": "Receivers whose /metrics this Prometheus scrapes and that have read their configuration (wherry_capacity is set once the receiver is configured).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (pool) (wherry_capacity{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Capacity",
      "description": "Tasks each receiver holds at once.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool) (wherry_capacity{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Capacity in use",
      "description": "Tasks held over capacity, per receiver.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, instance) (wherry_in_flight{pool=~\"$pool\", instance=~\"$instance\"}) / sum by (pool, instance) (wherry_capacity{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}} {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tasks in flight by profile",
      "description": "Tasks held, by the plugin profile they were routed to.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, profile) (wherry_in_flight{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}} {{profile}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Versions",
      "description": "The wherry release each scraped receiver runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (version, revision) (wherry_build_info{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Admission",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Admissions by profile",
      "description": "Tasks admitted per second, by the profile they were routed to.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, profile) (rate(wherry_admissions_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{profile}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rejections by reason",
      "description": "Tasks rejected per second, by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, reason) (rate(wherry_rejections_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Start failures by class",
      "description": "Start failures per second: input-too-large, dispatch, platform, and offer-unavailable (a member with no matching profile).",
