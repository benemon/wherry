      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 110
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, topic) (rate(wherry_admissions_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]) * on (pool, instance, profile) group_left (topic) (wherry_profile_ready{pool=~\"$pool\", instance=~\"$instance\"} * 0 + 1))",
          "legendFormat": "{{pool}} {{topic}}"
        }
      ]
    }
  ]
}
