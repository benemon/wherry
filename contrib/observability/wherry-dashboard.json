      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, state) (rate(wherry_runs_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{state}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Runs failed at the delivery budget with no profile",
      "description": "Runs a receiver ended TASK_STATE_FAILED with \"delivery budget exhausted\" before any plugin profile took them (profile=\"none\"). A run that spends its budget on start failures ends with its profile and counts under Runs ended by state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool) (increase(wherry_runs_total{pool=~\"$pool\", instance=~\"$instance\", profile=\"none\", state=\"failed\"}[$__rate_interval]))",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Dispatch outcomes",
      "description": "Dispatches per second: created, nothing, unknown.",
      "datasource": {
        "type": "prometheus",
