          "legendFormat": "p50 {{pool}} {{profile}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, pool, profile) (rate(wherry_queue_wait_seconds_bucket{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95 {{pool}} {{profile}}"
        }
      ]
    },
