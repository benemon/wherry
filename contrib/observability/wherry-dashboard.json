{
  "title": "wherry receivers",
  "uid": "wherry-receivers",
  "description": "Receivers, admission, run durations, plugins, Kafka and routing for wherry pools, from the receiver's /metrics.",
  "tags": [
    "wherry"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://benemon.github.io/wherry/runbooks",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "pool",
        "label": "Pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(wherry_capacity, pool)",
          "refId": "pool"
        },
        "definition": "label_values(wherry_capacity, pool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Receiver",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(wherry_capacity{pool=~\"$pool\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(wherry_capacity{pool=~\"$pool\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Receivers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Receivers reporting",
      "description": "Receivers whose /metrics this Prometheus scrapes and that have read their configuration (wherry_capacity is set once the receiver is configured).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (pool) (wherry_capacity{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Capacity",
      "description": "Tasks each receiver holds at once.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool) (wherry_capacity{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Capacity in use",
      "description": "Tasks held over capacity, per receiver.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, instance) (wherry_in_flight{pool=~\"$pool\", instance=~\"$instance\"}) / sum by (pool, instance) (wherry_capacity{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}} {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tasks in flight by profile",
      "description": "Tasks held, by the plugin profile they were routed to.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, profile) (wherry_in_flight{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}} {{profile}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Runs past their task_ended_by",
      "description": "Tasks held past their task_ended_by, or the 6h run cap, that have not ended, by the plugin profile they were routed to. WherryRunStuckPastDeadline fires when one stays above 0 for 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, profile) (wherry_runs_past_deadline{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}} {{profile}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Advertisement age",
      "description": "Seconds since each receiver's latest advertisement Kafka acknowledged. Hosts place tasks only on a receiver whose advertisement is under 120 seconds old.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "time() - max by (pool, instance) (wherry_advertised_timestamp_seconds{pool=~\"$pool\", instance=~\"$instance\"})",
          "legendFormat": "{{pool}} {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Versions",
      "description": "The wherry release each scraped receiver runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (version, revision) (wherry_build_info{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Custodian takeovers",
      "description": "Takeover and contested snapshots a receiver published for its pool's key custody, by reason; each raises WherryCustodianTakeover.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, instance, reason) (increase(wherry_custodian_takeovers_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{instance}} {{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Admission",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Admissions by profile",
      "description": "Tasks admitted per second, by the profile they were routed to.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, profile) (rate(wherry_admissions_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{profile}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rejections by reason",
      "description": "Tasks rejected per second, by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, reason) (rate(wherry_rejections_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Start failures by class",
      "description": "Start failures per second: input-too-large, dispatch, platform.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, profile, class) (rate(wherry_start_failures_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{profile}} {{class}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Runs ended by state",
      "description": "Runs that reached a terminal state, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, state) (rate(wherry_runs_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{state}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Runs ended at the delivery budget",
      "description": "Runs a receiver ended TASK_STATE_FAILED with \"delivery budget exhausted\", by tenant and the plugin profile that held them, profile=\"none\" where none did.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, tenant, profile) (increase(wherry_delivery_budget_exhausted_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{tenant}} {{profile}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Dispatch outcomes",
      "description": "Dispatches per second: created, nothing, unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pool, profile, outcome) (rate(wherry_dispatch_outcomes_total{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{pool}} {{profile}} {{outcome}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Durations",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Run duration",
      "description": "Time from this attempt's claim to the run's terminal state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, pool, profile) (rate(wherry_run_duration_seconds_bucket{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50 {{pool}} {{profile}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, pool, profile) (rate(wherry_run_duration_seconds_bucket{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95 {{pool}} {{profile}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Queue wait",
      "description": "Time from submission to first claim.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, pool, profile) (rate(wherry_queue_wait_seconds_bucket{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50 {{pool}} {{profile}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, pool, profile) (rate(wherry_queue_wait_seconds_bucket{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95 {{pool}} {{profile}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Placement",
      "description": "Time from dispatch to the agent task starting, as the plugin reports it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, pool, profile) (rate(wherry_plugin_placement_seconds_bucket{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50 {{pool}} {{profile}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, pool, profile) (rate(wherry_plugin_placement_seconds_bucket{pool=~\"$pool\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95 {{pool}} {{profile}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Open waits by outcome",
      "description": "Open request waits per second: opened, refused, unanswered, expired.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
