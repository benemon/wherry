{
  "claude-code": {
    "doc": "https://code.claude.com/docs/en/authentication",
    "env": [
      "CLAUDE_CODE_OAUTH_TOKEN"
    ],
    "id": "claude-code",
    "name": "Claude Code"
  },
  "codex": {
    "doc": "https://developers.openai.com/codex/noninteractive",
    "env": [
      "CODEX_API_KEY"
    ],
    "id": "codex",
    "name": "Codex CLI"
  },
  "copilot-cli": {
    "doc": "https://docs.github.com/en/copilot/how-tos/set-up/install-copilot-cli#authenticating-with-copilot-cli",
    "env": [
      "COPILOT_GITHUB_TOKEN"
    ],
    "id": "copilot-cli",
    "name": "GitHub Copilot CLI"
  },
  "cursor": {
    "doc": "https://cursor.com/docs/cli/reference/parameters",
    "env": [
      "CURSOR_API_KEY"
    ],
    "id": "cursor",
    "name": "Cursor CLI"
  }
}
